{
  "expo": {
    "name": "cshub",
    "slug": "cshub",
    "version": "0.035",
    "orientation": "portrait",
    "icon": "./assets/images/logo.png",
    "scheme": "cshub",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0F1C38",
        "foregroundImage": "./assets/images/logo.png"
      },
      "package": "com.isackskyla.cshub",
      "versionCode": 1,
      "softwareKeyboardLayoutMode": "pan",
      "permissions": [
        "WRITE_EXTERNAL_STORAGE",
        "REQUEST_INSTALL_PACKAGES"
      ]
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/logo.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-intent-launcher",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notifications-icon.png",
          "color": "#0F1C38"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0F1C38"
        }
      ],
      "expo-font",
      "expo-image",
      "expo-web-browser",
      "react-native-video",
      "expo-video",
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "useLegacyPackaging": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "updates": {
      "url": "https://u.expo.dev/bcdfdd20-a975-40cd-a1c9-99109106d032",
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "bcdfdd20-a975-40cd-a1c9-99109106d032"
      }
    }
  }
}